\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Example line fitting demonstration on a grape-like from the RXJ0232-44 cluster, with MUSE continuum generated over the HST WFC3 F689M filter, covering the galaxy's $H\beta $ and [OIII] doublet at observed wavelength. Note the galaxy's faint stellar continuum and pronounced Balmer series- and oxygen-forbidden-line emission. We demonstrate doublet fitting for the [OII] line pair, which is unresolved in MUSE for all EELGs in this work. }}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fitting}{{5}{5}{Example line fitting demonstration on a grape-like from the RXJ0232-44 cluster, with MUSE continuum generated over the HST WFC3 F689M filter, covering the galaxy's $H\beta $ and [OIII] doublet at observed wavelength. Note the galaxy's faint stellar continuum and pronounced Balmer series- and oxygen-forbidden-line emission. We demonstrate doublet fitting for the [OII] line pair, which is unresolved in MUSE for all EELGs in this work}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Flux extinction calibration metrics histogrammed by correction method. Top left shows distribution of E(B-V) values as discussed in \textbf  {Secion~\ref {sec:cat}}; note the expected log-normal distribution on the colour excess, and the tighter distribution on $H\alpha /H\beta $ expected from the high SNR of the lines. Also plotted are the histogrammed corrected Balmer decrement flux ratio and (fitting calibrator) [OIII] doublet flux ratio, all of which follow the expected ratios and Gaussian distributions as discussed.}}{5}{figure.caption.6}\protected@file@percent }
